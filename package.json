{
  "name": "oasis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/prepare-map-worker.mjs && npm run build:console",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node tools/prepare-map-worker.mjs && npm run build:console",
    "build": "next build",
    "build:console": "node dashboard/scripts/assets.mjs && vite build",
    "dev:console": "vite --host 127.0.0.1",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "next start --hostname 127.0.0.1 --port 3000",
    "test": "node --test dashboard/tests/*.test.js",
    "test:browser": "node dashboard/scripts/browser-check.mjs",
    "data:export": "uv run python dashboard/scripts/export_data.py out/ros-valley"
  },
  "dependencies": {
    "cesium": "1.124.0",
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "google-libphonenumber": "^3.2.44",
    "hls.js": "^1.6.16",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-map-gl": "^8.1.1",
    "rss-parser": "^3.13.0",
    "satellite.js": "^7.0.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "vite": "^7.3.0"
  }
}
